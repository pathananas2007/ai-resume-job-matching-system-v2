rules_version = '2';service cloud.firestore {  match /databases/{database}/documents {    // Default deny    match /{document=**} {      allow read, write: if false;    }    // Auth helpers    function isSignedIn() {      return request.auth != null;    }    function isOwner(userId) {      return isSignedIn() && request.auth.uid == userId;    }    function isValidId(id) {      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');    }    // Profiles    match /profiles/{uid} {      allow get: if isOwner(uid);      allow create: if isOwner(uid)         && request.resource.data.keys().hasAll(['uid', 'email', 'role'])        && request.resource.data.role in ['seeker', 'recruiter'];      allow update: if isOwner(uid) && (        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resumeText', 'skills', 'lastAnalyzed', 'displayName'])      );    }    // Jobs    match /jobs/{jobId} {      allow list: if isSignedIn();      allow get: if isSignedIn();      allow create: if isSignedIn()         && request.resource.data.recruiterId == request.auth.uid        && isValidId(jobId);      allow update: if isSignedIn()         && resource.data.recruiterId == request.auth.uid        && request.resource.data.recruiterId == request.auth.uid;      allow delete: if isSignedIn() && resource.data.recruiterId == request.auth.uid;    }    // Analyses    match /analyses/{analysisId} {      allow get: if isSignedIn() && (        resource.data.seekerId == request.auth.uid ||         get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.recruiterId == request.auth.uid      );      allow list: if isSignedIn() && (        resource.data.seekerId == request.auth.uid ||        get(/databases/$(database)/documents/jobs/$(resource.data.jobId)).data.recruiterId == request.auth.uid      );      allow create: if isSignedIn() && request.resource.data.seekerId == request.auth.uid;      allow update: if isSignedIn() && resource.data.seekerId == request.auth.uid;      allow delete: if isSignedIn() && resource.data.seekerId == request.auth.uid;    }  }}